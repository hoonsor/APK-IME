<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- App 內更新：用 PackageInstaller 安裝從 GitHub Releases 下載的新版 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 每日自動備份：開機後保留排程（一般權限，安裝時自動授予；沒有也能用，下次開啟輸入法會重排） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 輸入法服務（對話 A 實作 ImeService） -->
        <service
            android:name=".ImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 設定頁 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 字典檢視／編輯（自建詞、英文詞、常用短語） -->
        <activity
            android:name=".settings.DictionaryActivity"
            android:exported="false"
            android:label="字典"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 四符號鍵自訂 -->
        <activity
            android:name=".settings.PunctKeysActivity"
            android:exported="false"
            android:label="自訂四符號鍵"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI 模型設定（API key、各用途模型、語音選項） -->
        <activity
            android:name=".ai.AiSettingsActivity"
            android:exported="false"
            android:label="AI 模型設定"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 字典匯出檔分享（Google Drive、Dropbox…）；不對外公開，只靠分享時的暫時授權 -->
        <provider
            android:name=".settings.ExportProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 每日自動備份（hoonsor-kit android-auto-backup）：寫到 Documents/HoonsorBackup/ZhuyinIME/，Dropsync 同步到 Dropbox。
             類別名稱要寫完整（applicationId 是 tw.hoonsor.ime，和程式碼套件 tw.hoonsor.ime.app 不同，不能用「.」開頭的簡寫） -->
        <meta-data android:name="tw.hoonsor.backup.SOURCE" android:value="tw.hoonsor.ime.app.settings.ZhuyinBackupSource" />
        <service
            android:name="tw.hoonsor.backup.BackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 接收 App 內更新的安裝結果（PackageInstaller session） -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
