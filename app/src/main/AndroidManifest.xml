<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 輸入法服務（對話 A 實作 ImeService） -->
        <service
            android:name=".ImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 設定頁 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 字典檢視／編輯（自建詞、英文詞、常用短語） -->
        <activity
            android:name=".settings.DictionaryActivity"
            android:exported="false"
            android:label="字典"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI 模型設定（API key、各用途模型、語音選項） -->
        <activity
            android:name=".ai.AiSettingsActivity"
            android:exported="false"
            android:label="AI 模型設定"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 字典匯出檔分享（Google Drive、Dropbox…）；不對外公開，只靠分享時的暫時授權 -->
        <provider
            android:name=".settings.ExportProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
