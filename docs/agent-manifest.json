{
  "api": 1,
  "app": "倬注音",
  "package": "tw.hoonsor.ime",
  "version": "0.6.1",
  "status": "planned",
  "description": "超注音式簡拼注音輸入法＋AI 語音輸入與改寫。Agent API 尚未實作，以下動作全部為規劃。鍵盤送字（替其他 App 打字）不開放。",
  "actions": [
    {
      "name": "dictionary_phrase_list",
      "title": "查詢中文自建詞",
      "description": "列出注音自建詞，可用關鍵字篩選。",
      "risk": "read",
      "params": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "關鍵字（詞或注音），空白則全部"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        "我的字典裡有哪些自建詞",
        "查一下字典有沒有「拉斐爾」"
      ],
      "status": "planned",
      "features": [
        "Z5",
        "D1"
      ]
    },
    {
      "name": "dictionary_phrase_add",
      "title": "新增中文自建詞",
      "description": "新增一個中文詞；注音省略時用系統詞庫自動判斷。",
      "risk": "reversible",
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "reading": {
            "type": "string",
            "description": "注音，每字一個音節、空白分隔，例如「ㄒㄧㄠˇ ㄗ ㄋㄢˊ」；可省略"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "examples": [
        "把「倬注音」加到字典",
        "新增詞「拉斐爾」"
      ],
      "status": "planned",
      "features": [
        "Z5",
        "D1"
      ]
    },
    {
      "name": "dictionary_phrase_delete",
      "title": "刪除中文自建詞",
      "description": "刪除一個中文自建詞（內建詞不能刪）。",
      "risk": "destructive",
      "params": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "type": "string",
            "description": "同一個詞有多個讀音時指定"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "examples": [
        "從字典刪掉「小資男」"
      ],
      "status": "planned",
      "features": [
        "Z6"
      ]
    },
    {
      "name": "dictionary_word_list",
